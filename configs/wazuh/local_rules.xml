<group name="soc-lab,">

  <!-- Brute Force Detection -->
  <rule id="100001" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5503</if_matched_sid>
    <description>Brute force attack detected</description>
    <group>authentication_failures,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <!-- SQL Injection Detection -->
  <rule id="100002" level="12">
    <if_group>web_appsec</if_group>
    <url_match>select|union|insert|drop|1=1|or 1</url_match>
    <description>SQL Injection attempt detected</description>
    <group>attack,pci_dss_6.5.1,</group>
  </rule>

  <!-- XSS Detection -->
  <rule id="100003" level="12">
    <if_group>web_appsec</if_group>
    <url_match><script>|javascript:|onerror=|onload=</url_match>
    <description>XSS attempt detected</description>
    <group>attack,pci_dss_6.5.7,</group>
  </rule>

  <!-- Privilege Escalation -->
  <rule id="100004" level="12">
    <if_group>syslog</if_group>
    <match>sudo</match>
    <description>Privilege escalation attempt</description>
    <group>attack,pci_dss_10.2.5,</group>
  </rule>

  <!-- Web Shell Detection -->
  <rule id="100005" level="15">
    <if_group>syscheck</if_group>
    <match>.php|.asp|.aspx|.jsp</match>
    <description>Possible web shell upload detected</description>
    <group>attack,pci_dss_6.5.8,</group>
  </rule>

</group>
